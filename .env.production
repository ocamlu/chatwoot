# ChatWoot Configuration (Basado en .env.example)
#secret key generada hex base 64, puedes generarlo en cualquier sitio web
SECRET_KEY_BASE=705426e3adcfd25b1678f131dabaa4b7db00bbdf3ccf2712844fc39799ee9a36fd85ae08f736b8e22597675dcd37fe2131b5d6c4b1b1df45d324a8a5ec60f5af
FRONTEND_URL=https://chatwoot.bot.com
